# Copy to .env and fill in. Never commit .env.

PORT=4000

# --- MongoDB (Atlas or any replica set; change streams need a replica set)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/thingsstring?retryWrites=true&w=majority

# --- MQTT broker
MQTT_URL=mqtts://your-broker.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_TOPIC=ts/#
# Prefix for client ids: the API connects as "<MQTT_CLIENT_ID>-api".
# Use a DIFFERENT value on a local/dev copy so it never disconnects production.
MQTT_CLIENT_ID=thingsstring-backend

# --- Auth
# At least 32 random characters: `openssl rand -hex 32`. Changing it logs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# --- Optional
# Seconds without telemetry before a device counts as offline (default 300)
# DEVICE_OFFLINE_THRESHOLD_SEC=300
# Behind a reverse proxy / PaaS router: 1 (number of proxy hops) so rate limits and audit logs see real client IPs
# TRUST_PROXY=1
# Comma-separated allowed browser origins (default: any)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Backups: folder and how many to keep (default ./backups, 8)
# BACKUP_DIR=./backups
# BACKUP_KEEP=8
# Timezone for the weekly backup job (default: server time)
# BACKUP_TIMEZONE=Asia/Colombo

# Uploaded images (avatars, custom icons). Default: ./uploads next to the code.
# Not part of the database backup: back this folder up too.
# UPLOAD_DIR=/home/ubuntu/thingsstring-uploads
