{
  "name": "thingsstring",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/scheduler/worker.js",
    "start:automation": "node src/automation/worker.js",
    "dev": "nodemon src/server.js",
    "worker": "nodemon src/scheduler/worker.js",
    "automation-worker": "nodemon src/automation/worker.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "backup-telemetry": "node scripts/backup_and_cleanup_telemetry.js",
    "backup-db": "node scripts/backup_full_db.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "ThingsString IoT backend: REST API, MQTT ingest, scheduler and automation workers",
  "dependencies": {
    "agenda": "^5.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cron-parser": "^3.5.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.0",
    "mongoose": "^9.0.2",
    "mqtt": "^5.14.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
